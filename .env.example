# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
WEBAPP_URL=https://your-username.github.io/interactive-novel-frontend/

# Turso Database (production)
# Создайте бесплатный аккаунт: https://turso.tech
# turso db create interactive-novel
# turso db tokens create interactive-novel
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Local development (если Turso не настроен — используется SQLite)
DB_PATH=./db.sqlite3

# Render auto-sets this:
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# PORT=8000
